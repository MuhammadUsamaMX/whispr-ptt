#!/usr/bin/env python3
"""
whispr-ptt: Push-to-talk speech-to-text daemon
Press F9 once → record audio
Press F9 again → transcribe → paste at cursor (or copy to clipboard on typing failure)

Standalone — no external app required.
Dependencies: python-evdev, pywhispercpp (pip), ydotool, wl-clipboard, pipewire
"""

import os
import select
import signal
import subprocess
import sys
import tempfile
import threading
import time

# ── Config ────────────────────────────────────────────────────────────────────
MODEL  = "/usr/local/share/whispr/ggml-base.en.bin"
HOTKEY = ("f9",)   # (key,) toggle mode, or (modifier, key) hold mode
RETRIGGER_GUARD_SEC = 0.45   # ignore hotkey re-fire immediately after release
LIVE_PREVIEW_INTERVAL_SEC = 0.8   # seconds between live typing cycles
LIVE_PREVIEW_MIN_BYTES = 12800    # min new bytes before transcribing a chunk (~0.4s)
TOGGLE_GUARD_SEC = 0.35
WAV_HDR = 44          # standard PCM WAV header size in bytes
BYTES_PER_SEC = 32000 # 16kHz * 2 bytes * 1 channel
MIC_SOURCE = "alsa_input.pci-0000_0f_00.6.analog-stereo"  # hardware mic only
# ──────────────────────────────────────────────────────────────────────────────

try:
    import evdev
    from evdev import InputDevice, ecodes
except ImportError:
    print("[whispr-ptt] ERROR: python-evdev not found. Install: pacman -S python-evdev", flush=True)
    sys.exit(1)

try:
    from pywhispercpp.model import Model as WhisperModel
except ImportError:
    print("[whispr-ptt] ERROR: pywhispercpp not found. Run: sudo pip install pywhispercpp --break-system-packages", flush=True)
    sys.exit(1)

# ── Globals ───────────────────────────────────────────────────────────────────
recording_proc   = None
audio_file       = None
lock             = threading.Lock()
whisper_model    = None
_grabbed_devs    = []   # keyboards grabbed while hotkey is held
_transcribe_lock = threading.Lock()
_live_stop_event = threading.Event()
_live_thread     = None
_typed_so_far    = ""   # text already typed at cursor during this session
_last_typed_byte = WAV_HDR  # byte offset up to which live worker has already typed
_audio_fd        = None   # open file handle for parec stdout
_transcribing    = False


def log(msg):
    print(f"[whispr-ptt] {msg}", flush=True)


def notify(title, body="", urgency="normal", timeout=4000, replace_id=0):
    """Send GNOME desktop notification via notify-send."""
    uid = os.getuid()
    env = os.environ.copy()
    env.setdefault("XDG_RUNTIME_DIR",          f"/run/user/{uid}")
    env.setdefault("DBUS_SESSION_BUS_ADDRESS",  f"unix:path=/run/user/{uid}/bus")
    env.setdefault("WAYLAND_DISPLAY",           "wayland-0")
    cmd = [
        "notify-send",
        "-a", "whispr-ptt",
        "-u", urgency,
        "-t", str(timeout),
        "-i", "audio-input-microphone",
    ]
    if replace_id:
        cmd += ["-r", str(replace_id)]
    cmd.append(title)
    if body:
        cmd.append(body)
    subprocess.run(cmd, env=env, check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ── Whisper model (loaded once at startup) ────────────────────────────────────
def load_model():
    global whisper_model
    log(f"Loading model {os.path.basename(MODEL)} ...")
    os.environ.setdefault("GGML_VULKAN", "1")
    # Suppress whisper.cpp stderr noise
    old_fd = os.dup(2)
    with open(os.devnull, "w") as devnull:
        os.dup2(devnull.fileno(), 2)
        try:
            whisper_model = WhisperModel(MODEL)
        finally:
            os.dup2(old_fd, 2)
            os.close(old_fd)
    log("Model ready")
    notify("whispr-ptt ready", "Press F9 to start/stop recording", urgency="low", timeout=5000)


def _run_transcribe(wav_path):
    """Raw transcription — caller must hold _transcribe_lock."""
    import re as _re
    segments = whisper_model.transcribe(wav_path)
    raw = " ".join(s.text for s in segments)
    # Remove whisper hallucination tokens: [BLANK_AUDIO], (upbeat music), etc.
    raw = _re.sub(r'\[.*?\]', '', raw)          # strip [BLANK_AUDIO] [MUSIC] etc.
    raw = _re.sub(r'\(.*?\)', '', raw)          # strip (upbeat music) (applause) etc.
    return " ".join(raw.split())


def transcribe(wav_path):
    with _transcribe_lock:
        return _run_transcribe(wav_path)


def _copy_to_clipboard(text):
    subprocess.run(["wl-copy",             text], check=False)
    subprocess.run(["wl-copy", "--primary", text], check=False)


def _write_wav_chunk(path, raw_pcm):
    """Write a minimal 16kHz mono s16 PCM WAV file from raw PCM bytes."""
    import struct
    data_size = len(raw_pcm)
    with open(path, 'wb') as f:
        f.write(b'RIFF')
        f.write(struct.pack('<I', 36 + data_size))
        f.write(b'WAVE')
        f.write(b'fmt ')
        f.write(struct.pack('<I', 16))       # chunk size
        f.write(struct.pack('<H', 1))        # PCM
        f.write(struct.pack('<H', 1))        # mono
        f.write(struct.pack('<I', 16000))    # sample rate
        f.write(struct.pack('<I', 32000))    # byte rate
        f.write(struct.pack('<H', 2))        # block align
        f.write(struct.pack('<H', 16))       # bits per sample
        f.write(b'data')
        f.write(struct.pack('<I', data_size))
        f.write(raw_pcm)


def _type_at_cursor(text):
    """Type text at the current cursor position via ydotool."""
    uid = os.getuid()
    env = os.environ.copy()
    env["YDOTOOL_SOCKET"]  = f"/run/user/{uid}/.ydotool_socket"
    env.setdefault("WAYLAND_DISPLAY", "wayland-0")
    result = subprocess.run(
        ["ydotool", "type", "--key-delay", "8", "--", text],
        env=env, timeout=15, check=False,
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    return result.returncode == 0


# ── Audio recording ───────────────────────────────────────────────────────────
def start_recording():
    global recording_proc, audio_file, _live_thread, _typed_so_far, _last_typed_byte, _audio_fd
    fd, audio_file = tempfile.mkstemp(suffix=".raw", prefix="whispr_")
    os.close(fd)
    # Write a 44-byte placeholder so _last_typed_byte = WAV_HDR = 44 is correct;
    # parec appends raw PCM after it.
    with open(audio_file, 'wb') as f:
        f.write(b'\x00' * WAV_HDR)
    # parec respects --source directly via PipeWire's PulseAudio compat layer.
    # It outputs raw s16le PCM to stdout — no WAV header.
    _audio_fd = open(audio_file, 'ab')
    recording_proc = subprocess.Popen(
        ["parec", "--device", MIC_SOURCE,
         "--rate=16000", "--channels=1", "--format=s16le"],
        stdout=_audio_fd,
        stderr=subprocess.DEVNULL
    )
    _live_stop_event.clear()
    _typed_so_far    = ""
    _last_typed_byte = WAV_HDR
    _live_thread = threading.Thread(target=live_typing_worker, args=(audio_file,), daemon=True)
    _live_thread.start()
    log("Recording...")


def live_typing_worker(src_wav):
    """Every LIVE_PREVIEW_INTERVAL_SEC: read only the NEW raw PCM bytes since
    the last cycle, wrap them in a fresh WAV, transcribe just that chunk, and
    immediately type the result at cursor.  Each cycle stays O(chunk_size) so
    transcription time never grows with recording length."""
    global _typed_so_far, _last_typed_byte
    while not _live_stop_event.wait(LIVE_PREVIEW_INTERVAL_SEC):
        if not os.path.exists(src_wav):
            continue
        try:
            file_size   = os.path.getsize(src_wav)
            chunk_start = _last_typed_byte
            chunk_end   = file_size

            if chunk_end - chunk_start < LIVE_PREVIEW_MIN_BYTES:
                continue  # not enough new audio yet

            with open(src_wav, 'rb') as fh:
                fh.seek(chunk_start)
                raw_pcm = fh.read(chunk_end - chunk_start)

            if len(raw_pcm) < LIVE_PREVIEW_MIN_BYTES:
                continue

            fd, snap = tempfile.mkstemp(suffix=".wav", prefix="whispr_live_")
            os.close(fd)
            try:
                _write_wav_chunk(snap, raw_pcm)

                if not _transcribe_lock.acquire(blocking=False):
                    continue  # final transcription starting; stop event fires shortly
                try:
                    text = _run_transcribe(snap)
                finally:
                    _transcribe_lock.release()

                # Always advance pointer so we never re-transcribe the same silence
                _last_typed_byte = chunk_end

                if text:
                    prefix = " " if _typed_so_far and not _typed_so_far.endswith(" ") else ""
                    to_type = prefix + text
                    _typed_so_far += to_type
                    _type_at_cursor(to_type)
                    log(f"live: {text.strip()}")
            finally:
                try:
                    os.unlink(snap)
                except Exception:
                    pass
        except Exception as e:
            log(f"live worker: {e}")
            continue


def stop_and_transcribe():
    """Stop recording.  Transcribe only the bytes the live worker hasn't typed,
    then type them.  Falls back to clipboard on typing failure."""
    global recording_proc, audio_file, _live_thread, _transcribing, _typed_so_far, _last_typed_byte, _audio_fd
    if not recording_proc:
        return

    _transcribing = True

    # Stop the live worker before touching the audio file
    _live_stop_event.set()
    if _live_thread and _live_thread.is_alive():
        _live_thread.join(timeout=3)
    _live_thread = None

    recording_proc.terminate()
    recording_proc.wait()
    recording_proc = None
    if _audio_fd:
        try:
            _audio_fd.close()
        except Exception:
            pass
        _audio_fd = None

    if not audio_file or not os.path.exists(audio_file):
        return

    rem_wav = None
    full_wav = None
    try:
        file_size     = os.path.getsize(audio_file)
        untyped_start = _last_typed_byte
        untyped_bytes = file_size - untyped_start

        text = ""
        if untyped_bytes >= LIVE_PREVIEW_MIN_BYTES:
            # Transcribe only the tail the live worker didn't cover
            with open(audio_file, 'rb') as fh:
                fh.seek(untyped_start)
                raw_pcm = fh.read(untyped_bytes)
            fd, rem_wav = tempfile.mkstemp(suffix=".wav", prefix="whispr_rem_")
            os.close(fd)
            _write_wav_chunk(rem_wav, raw_pcm)
            text = transcribe(rem_wav)
        elif not _typed_so_far:
            # Nothing typed live at all — wrap the whole raw PCM in a proper WAV
            with open(audio_file, 'rb') as fh:
                fh.seek(WAV_HDR)
                raw_pcm = fh.read()
            if raw_pcm:
                fd, full_wav = tempfile.mkstemp(suffix=".wav", prefix="whispr_full_")
                os.close(fd)
                _write_wav_chunk(full_wav, raw_pcm)
                text = transcribe(full_wav)

        if text:
            log(f"final: {text}")
            prefix = " " if _typed_so_far and not _typed_so_far.endswith(" ") else ""
            to_type = prefix + text
            ok = _type_at_cursor(to_type)
            if not ok:
                full = (_typed_so_far + to_type).strip()
                _copy_to_clipboard(full)
                notify("Copied to clipboard", full[:120], timeout=6000, replace_id=9999)
        elif not _typed_so_far:
            log("No speech detected")
    except Exception as e:
        log(f"Transcription error: {e}")
        notify("Transcription error", str(e), urgency="critical", timeout=6000, replace_id=9999)
    finally:
        for path in [audio_file, rem_wav, full_wav]:
            if path:
                try:
                    os.unlink(path)
                except Exception:
                    pass
        audio_file = None
        _transcribing = False


# ── Text injection ────────────────────────────────────────────────────────────
# _type_at_cursor() and _copy_to_clipboard() are the primary output helpers.
# paste_text() is kept only for the legacy hold-mode path (modifier + key).
def paste_text(text):
    uid = os.getuid()
    env = os.environ.copy()
    env["YDOTOOL_SOCKET"]  = f"/run/user/{uid}/.ydotool_socket"
    env.setdefault("WAYLAND_DISPLAY", "wayland-0")
    # Release any stuck modifier keys from the hold-mode hotkey combo
    for _k in ["shift:0", "ctrl:0", "alt:0", "super:0"]:
        subprocess.run(["ydotool", "key", _k], env=env, check=False)
    time.sleep(0.3)
    result = subprocess.run(
        ["ydotool", "type", "--key-delay", "8", "--", text],
        env=env, timeout=15, check=False,
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    return result.returncode == 0


# ── Hotkey events ─────────────────────────────────────────────────────────────
def on_keydown():
    with lock:
        if recording_proc is None:
            start_recording()


def on_keyup():
    with lock:
        threading.Thread(target=stop_and_transcribe, daemon=True).start()


def on_hotkey_toggle():
    with lock:
        if recording_proc is not None:
            threading.Thread(target=stop_and_transcribe, daemon=True).start()
        elif not _transcribing:
            start_recording()
        else:
            notify("Still transcribing", "Please wait", urgency="low", timeout=1500, replace_id=9999)


# ── evdev key listener ────────────────────────────────────────────────────────
_MODIFIER_CODES = {
    "shift": {ecodes.KEY_LEFTSHIFT, ecodes.KEY_RIGHTSHIFT},
    "ctrl":  {ecodes.KEY_LEFTCTRL,  ecodes.KEY_RIGHTCTRL},
    "alt":   {ecodes.KEY_LEFTALT,   ecodes.KEY_RIGHTALT},
    "super": {ecodes.KEY_LEFTMETA,  ecodes.KEY_RIGHTMETA},
}


def _key_code(name):
    return getattr(ecodes, f"KEY_{name.upper()}", None)


def find_keyboards(required_code=None):
    result = []
    for path in evdev.list_devices():
        try:
            dev = InputDevice(path)
            caps = dev.capabilities()
            if ecodes.EV_KEY not in caps or ecodes.KEY_A not in caps[ecodes.EV_KEY]:
                continue

            # Skip virtual/uinput devices (including ydotool) to avoid
            # self-trigger loops from injected keystrokes.
            name = (dev.name or "").lower()
            if any(t in name for t in ("ydotool", "uinput", "virtual")):
                continue

            # BUS_VIRTUAL devices are synthetic input sources.
            if getattr(dev.info, "bustype", None) == getattr(ecodes, "BUS_VIRTUAL", 0x06):
                continue

            if required_code is not None and required_code not in caps[ecodes.EV_KEY]:
                continue

            if ecodes.KEY_R in caps[ecodes.EV_KEY] or ecodes.KEY_F9 in caps[ecodes.EV_KEY]:
                result.append(dev)
        except Exception:
            pass
    return result


def run_key_listener():
    hotkey_items = tuple(HOTKEY) if isinstance(HOTKEY, (tuple, list)) else (HOTKEY,)
    hotkey_items = tuple(str(x).strip().lower() for x in hotkey_items if str(x).strip())

    if len(hotkey_items) == 1:
        key_name = hotkey_items[0]
        toggle_code = _key_code(key_name)
        if toggle_code is None:
            log(f"ERROR: unknown key '{key_name}'")
            sys.exit(1)

        keyboards = find_keyboards(required_code=toggle_code)
        if not keyboards:
            log("ERROR: no keyboard devices found (are you in the 'input' group? run: sudo usermod -aG input $USER, then re-login)")
            sys.exit(1)

        log(f"Listening for {key_name.upper()} on {len(keyboards)} device(s) — press once to start, press again to stop/transcribe")
        fd_map = {d.fd: d for d in keyboards}
        last_toggle_ts = 0.0

        while True:
            try:
                readable, _, _ = select.select(fd_map.keys(), [], [], 2.0)
            except (ValueError, OSError):
                keyboards = find_keyboards(required_code=toggle_code)
                fd_map = {d.fd: d for d in keyboards}
                continue

            for fd in readable:
                dev = fd_map[fd]
                try:
                    for event in dev.read():
                        if event.type != ecodes.EV_KEY:
                            continue
                        if event.code != toggle_code:
                            continue
                        if event.value != 1:
                            continue

                        now = time.monotonic()
                        if (now - last_toggle_ts) < TOGGLE_GUARD_SEC:
                            continue
                        last_toggle_ts = now
                        on_hotkey_toggle()
                except OSError:
                    del fd_map[fd]
                    if not fd_map:
                        log("WARNING: all keyboards disappeared, reconnecting...")
                        time.sleep(2)
                        keyboards = find_keyboards(required_code=toggle_code)
                        fd_map = {d.fd: d for d in keyboards}
                    break

        return

    if len(hotkey_items) != 2:
        log("ERROR: HOTKEY must be either (key,) for toggle mode or (modifier, key) for hold mode")
        sys.exit(1)

    mod_name, key_name = hotkey_items
    mod_codes    = _MODIFIER_CODES.get(mod_name, set())
    trigger_code = _key_code(key_name)

    if not mod_codes:
        log(f"ERROR: unknown modifier '{mod_name}'")
        sys.exit(1)

    if trigger_code is None:
        log(f"ERROR: unknown key '{key_name}'")
        sys.exit(1)

    keyboards = find_keyboards(required_code=trigger_code)
    if not keyboards:
        log("ERROR: no keyboard devices found (are you in the 'input' group? run: sudo usermod -aG input $USER, then re-login)")
        sys.exit(1)

    log(f"Listening for {mod_name.capitalize()}+{key_name.upper()} on {len(keyboards)} device(s) — hold to record, release to transcribe & paste")

    fd_map     = {d.fd: d for d in keyboards}
    down_counts = {}
    mod_held   = False
    trig_down  = False
    last_hotkey_release_ts = 0.0

    def inject_hotkey_keyup():
        _uid = os.getuid()
        _env = os.environ.copy()
        _env["YDOTOOL_SOCKET"]  = f"/run/user/{_uid}/.ydotool_socket"
        _env.setdefault("WAYLAND_DISPLAY", "wayland-0")
        # Send explicit release events for trigger/modifier and both shift sides.
        subprocess.run(
            ["ydotool", "key", f"{key_name}:0", f"{mod_name}:0", "leftshift:0", "rightshift:0"],
            env=_env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            timeout=2, check=False,
        )

    def grab_all():
        global _grabbed_devs
        _grabbed_devs = []
        for d in list(fd_map.values()):
            try:
                d.grab()
                _grabbed_devs.append(d)
            except Exception:
                pass
        # Wayland started its own compositor-side auto-repeat timer when it saw
        # the key_down event. Evdev grab stops the kernel sending more events to
        # libinput, but Wayland's internal timer keeps firing. Cancel it by
        # injecting a fake key-up for the trigger key (and modifier) via ydotool.
        # This makes the compositor think the key was released → repeat stops.
        # Use subprocess.run (blocking) so the fake key-up events are delivered
        # to the compositor BEFORE we return.  With Popen the events could arrive
        # hundreds of ms later, letting Wayland's auto-repeat timer fire more
        # Shift+R keystrokes into the focused window.
        inject_hotkey_keyup()

    def ungrab_all():
        global _grabbed_devs
        for d in _grabbed_devs:
            try:
                d.ungrab()
            except Exception:
                pass
        _grabbed_devs = []

    while True:
        try:
            readable, _, _ = select.select(fd_map.keys(), [], [], 2.0)
        except (ValueError, OSError):
            ungrab_all()
            keyboards = find_keyboards()
            fd_map = {d.fd: d for d in keyboards}
            continue

        for fd in readable:
            dev = fd_map[fd]
            try:
                for event in dev.read():
                    if event.type != ecodes.EV_KEY:
                        continue
                    code  = event.code
                    value = event.value   # 0=up 1=down 2=repeat

                    if value == 1:
                        down_counts[code] = down_counts.get(code, 0) + 1
                    elif value == 0:
                        cur = down_counts.get(code, 0)
                        if cur <= 1:
                            down_counts.pop(code, None)
                        else:
                            down_counts[code] = cur - 1

                    if code in mod_codes:
                        mod_held = any(down_counts.get(c, 0) > 0 for c in mod_codes)
                        # If modifier released while hotkey was held, treat as key-up
                        if value == 0 and trig_down and not mod_held:
                            trig_down = False
                            inject_hotkey_keyup()
                            ungrab_all()
                            last_hotkey_release_ts = time.monotonic()
                            on_keyup()

                    elif code == trigger_code:
                        now = time.monotonic()
                        if value == 1 and mod_held and not trig_down:
                            if (now - last_hotkey_release_ts) < RETRIGGER_GUARD_SEC:
                                continue
                            trig_down = True
                            # Grab keyboards so OS never sees R repeating into the app
                            grab_all()
                            on_keydown()
                        elif value == 0 and trig_down:
                            trig_down = False
                            inject_hotkey_keyup()
                            ungrab_all()
                            last_hotkey_release_ts = now
                            on_keyup()
                        # value==2 (repeat) — ignored; device is grabbed so OS won't see it

            except OSError:
                del fd_map[fd]
                ungrab_all()
                if not fd_map:
                    log("WARNING: all keyboards disappeared, reconnecting...")
                    time.sleep(2)
                    keyboards = find_keyboards()
                    fd_map = {d.fd: d for d in keyboards}
                break


# ── Shutdown ──────────────────────────────────────────────────────────────────
def shutdown(sig, frame):
    log("Shutting down...")
    for d in _grabbed_devs:
        try:
            d.ungrab()
        except Exception:
            pass
    if recording_proc:
        recording_proc.terminate()
    sys.exit(0)


# ── Main ──────────────────────────────────────────────────────────────────────
if __name__ == "__main__":
    signal.signal(signal.SIGINT,  shutdown)
    signal.signal(signal.SIGTERM, shutdown)

    if not os.path.exists(MODEL):
        log(f"ERROR: model not found at {MODEL}")
        sys.exit(1)

    load_model()
    run_key_listener()